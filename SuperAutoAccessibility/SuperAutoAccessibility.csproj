<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SuperAutoAccessibility</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Auto-detect Super Auto Pets install via Steam registry. Override with /p:SAPPath=... -->
  <PropertyGroup>
    <SteamPath Condition="'$(SteamPath)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\SOFTWARE\Valve\Steam', 'SteamPath', null, RegistryView.Registry64))</SteamPath>
    <SteamPath Condition="'$(SteamPath)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Valve\Steam', 'InstallPath', null, RegistryView.Registry64, RegistryView.Registry32))</SteamPath>
    <SteamPath Condition="'$(SteamPath)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Valve\Steam', 'InstallPath', null, RegistryView.Registry64, RegistryView.Registry32))</SteamPath>
    <SAPPath Condition="'$(SAPPath)' == '' AND '$(SteamPath)' != '' AND Exists('$(SteamPath)\steamapps\common\Super Auto Pets\MelonLoader\net6\MelonLoader.dll')">$(SteamPath)\steamapps\common\Super Auto Pets</SAPPath>
  </PropertyGroup>

  <!-- Inline task: scan libraryfolders.vdf for SAP install in alternate Steam libraries -->
  <UsingTask TaskName="FindSAPInLibraries" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SteamPath ParameterType="System.String" Required="true" />
      <FoundPath ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        FoundPath = "";
        if (string.IsNullOrEmpty(SteamPath)) return true;
        var vdf = System.IO.Path.Combine(SteamPath, "steamapps", "libraryfolders.vdf");
        if (!System.IO.File.Exists(vdf)) return true;
        var text = System.IO.File.ReadAllText(vdf);
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(text, "\"path\"\\s+\"([^\"]+)\"")) {
          var lib = m.Groups[1].Value.Replace("\\\\", "\\");
          var candidate = System.IO.Path.Combine(lib, "steamapps", "common", "Super Auto Pets");
          if (System.IO.File.Exists(System.IO.Path.Combine(candidate, "MelonLoader", "net6", "MelonLoader.dll"))) {
            FoundPath = candidate;
            Log.LogMessage(MessageImportance.High, "[SAP] Found at: " + candidate);
            return true;
          }
        }
        Log.LogMessage(MessageImportance.High, "[SAP] Not found in any Steam library");
        return true;
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_ResolveSAPPath" BeforeTargets="ResolveAssemblyReferences;_GenerateRestoreGraphProjectEntry" Condition="'$(SAPPath)' == ''">
    <FindSAPInLibraries SteamPath="$(SteamPath)">
      <Output TaskParameter="FoundPath" PropertyName="SAPPath" />
    </FindSAPInLibraries>
    <Error Condition="'$(SAPPath)' == ''" Text="Super Auto Pets install not found. Either install the game via Steam (with MelonLoader), or pass an explicit path: dotnet build /p:SAPPath=&quot;C:\path\to\Super Auto Pets&quot;" />
    <Message Text="[SAP] Using SAPPath=$(SAPPath)" Importance="high" />
  </Target>

  <ItemGroup>
    <!-- MelonLoader Core -->
    <Reference Include="MelonLoader">
      <HintPath>$(SAPPath)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Modern Il2CppInterop Libraries (replaces deprecated UnhollowerBaseLib) -->
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(SAPPath)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(SAPPath)\MelonLoader\net6\Il2CppInterop.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Essential Il2Cpp System Libraries -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\Il2CppSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Game Assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppSpacewoodCore2">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\Il2CppSpacewoodCore2.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Unity Engine Modules -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.AudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(SAPPath)\MelonLoader\Il2CppAssemblies\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Harmony for patching -->
    <Reference Include="0Harmony">
      <HintPath>$(SAPPath)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Il2CppInterop.HarmonySupport">
      <HintPath>$(SAPPath)\MelonLoader\net6\Il2CppInterop.HarmonySupport.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Embed Tolk DLLs as resources -->
    <EmbeddedResource Include="..\lib\Tolk.dll">
      <LogicalName>SuperAutoAccessibility.Tolk.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\lib\TolkDotNet.dll">
      <LogicalName>SuperAutoAccessibility.TolkDotNet.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\lib\nvdaControllerClient64.dll">
      <LogicalName>SuperAutoAccessibility.nvdaControllerClient64.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\lib\SAAPI64.dll">
      <LogicalName>SuperAutoAccessibility.SAAPI64.dll</LogicalName>
    </EmbeddedResource>

    <!-- Embed sound effects -->
    <EmbeddedResource Include="..\Sounds\SAP_IsFrozen.ogg">
      <LogicalName>SuperAutoAccessibility.Sounds.SAP_IsFrozen.ogg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Sounds\SAP_CanCombine.ogg">
      <LogicalName>SuperAutoAccessibility.Sounds.SAP_CanCombine.ogg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Sounds\SAP_CanCombineAndWillLevelUp.ogg">
      <LogicalName>SuperAutoAccessibility.Sounds.SAP_CanCombineAndWillLevelUp.ogg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Sounds\SAP_Chained.ogg">
      <LogicalName>SuperAutoAccessibility.Sounds.SAP_Chained.ogg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Sounds\SAP_Unchained.ogg">
      <LogicalName>SuperAutoAccessibility.Sounds.SAP_Unchained.ogg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
